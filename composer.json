{
    "name": "wotz/filament-brigada-theme",
    "description": "The Brigada house style as a Filament panel theme, with six brio palettes and a palette switcher",
    "keywords": [
        "who owns the zebra",
        "laravel",
        "filament",
        "filament-brigada-theme"
    ],
    "homepage": "https://github.com/wotzebra/filament-brigada-theme",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.12"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Wotz\\FilamentBrigadaTheme\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wotz\\FilamentBrigadaTheme\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wotz\\FilamentBrigadaTheme\\Providers\\FilamentBrigadaThemeServiceProvider"
            ]
        }
    },
    "support": {
        "email": "info@whoownsthezebra.be"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
